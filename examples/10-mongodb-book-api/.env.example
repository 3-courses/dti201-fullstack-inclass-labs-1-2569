# Atlas: replace DB_USER, ENCODED_PASSWORD and YOUR_HOST in your private .env.
# Copy the real hostname from YOUR Cluster0 > Connect > Drivers.
MONGODB_URI=mongodb+srv://DB_USER:ENCODED_PASSWORD@YOUR_HOST/course_books?retryWrites=true&w=majority
PORT=3001
# Optional local Docker only: use this URI instead of the Atlas URI above.
# MONGODB_URI=mongodb://127.0.0.1:27018/course_books
# MONGO_PORT=27018
