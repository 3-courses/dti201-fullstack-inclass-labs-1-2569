{
  "name": "dti201-mongodb-book-lab",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "seed": "node --env-file=.env scripts/seed.js",
    "start": "node --env-file=.env src/server.js",
    "db:check": "node --env-file=.env scripts/check-db.js",
    "db:up": "docker compose up -d --wait --wait-timeout 120 db",
    "db:stop": "docker compose stop db",
    "test": "node --test test/model.test.js",
    "test:integration": "node --test test/database.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongoose": "^8.0.0"
  }
}
